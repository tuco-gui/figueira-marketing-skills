{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "figueira-content-squad",
  "version": "1.1.0",
  "description": "Squad de conteúdo da Figueira Marketing para estratégia editorial, ganchos, copy e carrosséis LinkedIn em ChatGPT e Codex.",
  "author": {
    "name": "Figueira Marketing",
    "url": "https://figueiramarketing.com.br"
  },
  "homepage": "https://github.com/tuco-gui/figueira-marketing-skills/tree/main/plugins/figueira-content-squad",
  "repository": "https://github.com/tuco-gui/figueira-marketing-skills",
  "keywords": [
    "figueira",
    "marketing",
    "linkedin",
    "content",
    "copywriting",
    "carousel"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Figueira Content Squad",
        "shortDescription": "Conteúdo estratégico LinkedIn",
        "longDescription": "Fluxo editorial da Figueira Marketing para estruturar contexto de cliente, planejar conteúdo, desenvolver ganchos, redigir posts e produzir carrosséis LinkedIn com consistência de voz, evidência e direção visual.",
        "developerName": "Figueira Marketing",
        "category": "Productivity",
        "capabilities": [
          "Estruturar contexto editorial do cliente",
          "Planejar calendário e briefings de conteúdo",
          "Criar e selecionar ganchos",
          "Redigir posts LinkedIn",
          "Transformar posts em carrosséis"
        ],
        "websiteURL": "https://figueiramarketing.com.br",
        "privacyPolicyURL": "https://github.com/tuco-gui/figueira-marketing-skills/blob/main/plugins/figueira-content-squad/PRIVACY.md",
        "termsOfServiceURL": "https://github.com/tuco-gui/figueira-marketing-skills/blob/main/plugins/figueira-content-squad/TERMS.md",
        "brandColor": "#C4191F",
        "composerIcon": "./assets/figueira-content-squad.png",
        "logo": "./assets/figueira-content-squad.png",
        "defaultPrompt": [
          "Planeje minha semana de conteúdo no LinkedIn com o Figueira Content Squad.",
          "Transforme este briefing em ganchos e um post de LinkedIn.",
          "Transforme este post aprovado em um carrossel de LinkedIn."
        ],
        "supportURL": "https://github.com/tuco-gui/figueira-marketing-skills/issues"
      }
    }
  }
}
